{
  "name": "skyface-app-kit",
  "version": "0.1.0",
  "private": true,
  "description": "나만의 앱 공장 Starter Kit — Figma 디자인 시스템 + 재사용 코드 + Cursor 규칙을 하나로 묶은 모노레포",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:tokens": "tsx scripts/build-tokens.ts",
    "sync:tokens": "tsx scripts/sync-figma-tokens.ts",
    "export:figma": "tsx scripts/export-tokens-studio.ts",
    "import:figma": "tsx scripts/import-tokens-studio.ts",
    "sync:figma": "tsx scripts/import-tokens-studio.ts && tsx scripts/build-tokens.ts",
    "create-app": "tsx scripts/create-new-app.ts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.2",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2"
}
