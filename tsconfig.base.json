{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@skyface/ui": ["packages/ui/src/index.ts"],
      "@skyface/ui/*": ["packages/ui/src/*"],
      "@skyface/hooks": ["packages/hooks/src/index.ts"],
      "@skyface/utils": ["packages/utils/src/index.ts"],
      "@skyface/api": ["packages/api/src/index.ts"],
      "@skyface/theme": ["packages/theme/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "build", "**/node_modules", "templates", "apps"]
}
